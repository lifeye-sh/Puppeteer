+ * unchanged without them. */
+extern int nt_rdpdr_back_gate(const BYTE* io, size_t len) __attribute__((weak));
+extern int nt_rdpdr_front_gate(BYTE* io, size_t len, size_t* outLen) __attribute__((weak));
+
 #define RTAG PROXY_TAG("channel.rdpdr")
 
