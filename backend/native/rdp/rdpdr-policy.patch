 			continue;
 
 		size_t len = Stream_Length(s);
+		size_t gated = len;
+		if (nt_rdpdr_front_gate && !nt_rdpdr_front_gate(Stream_Buffer(s), len, &gated))
+		{
+			/* Policy dropped this PDU entirely. */
+			Stream_Free(s, TRUE);
+			continue;
+		}
+		if (gated < len)
+		{
+			/* Announcement filter shortened the PDU in place. */
+			Stream_SetPosition(s, gated);
+			Stream_SealLength(s);
+		}
+		len = Stream_Length(s);
 		if (!Stream_SetPosition(s, len))
